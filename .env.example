# ============================================================
# Controle Maguinho — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.
# Apenas variáveis VITE_* são expostas ao frontend.

# ── Supabase ─────────────────────────────────────────────────
# URL do seu projeto Supabase (encontrada em: Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública anon (segura para o frontend — não é a service role!)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ──────────────────────────────────────────────────────
# Nome exibido no título da aplicação
VITE_APP_NAME=Controle Maguinho

# URL base da aplicação (sem barra final)
VITE_APP_URL=http://localhost:4200

# ── Atenção ──────────────────────────────────────────────────
# A SERVICE ROLE KEY do Supabase NUNCA deve ser inserida aqui.
# Ela só é usada em funções serverless backend (se necessário).
